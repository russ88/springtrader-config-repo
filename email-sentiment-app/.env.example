# Your Gmail address
GMAIL_USER=you@gmail.com

# Gmail App Password (NOT your regular Gmail password — see README for setup steps)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Anthropic API key — get one at https://console.anthropic.com
